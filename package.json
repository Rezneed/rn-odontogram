{
  "name": "@rezneed/rn-odontogram",
  "version": "1.0.0",
  "description": "Interactive dental chart (odontogram) for React Native — permanent and primary dentition, FDI tooth codes, built on react-native-svg.",
  "keywords": [
    "react-native",
    "odontogram",
    "dental",
    "teeth",
    "fdi",
    "svg"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rezneed/rn-odontogram.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "geometry": "node scripts/generate-geometry.mjs",
    "prepack": "yarn build",
    "test": "jest"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "jest": "^29.6.3",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-svg": "15.15.5",
    "svg-path-bounds": "^1.0.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  },
  "packageManager": "yarn@3.6.4",
  "engines": {
    "node": ">=18"
  }
}
